{{ if lookPath "herdr" -}}
#!/usr/bin/env bash
set -euo pipefail

herdr_version={{ output "herdr" "--version" | trim | quote }}

echo "🐑 Reinstalling herdr Pi integration to match $herdr_version"
herdr integration install pi
{{ else -}}
#!/usr/bin/env bash
echo "⚠️  herdr not found; skipping Pi integration install."
{{ end -}}
