{{ if lookPath "vp" -}}
#!/usr/bin/env bash
set -euo pipefail

packages=(
{{ range .npm_globals -}}
  {{ . | quote }}
{{ end -}}
)

echo "🔤 Installing/updating npm globals: ${packages[*]}"
vp install -g "${packages[@]}"
{{ else -}}
#!/usr/bin/env bash
echo "⚠️  vp not found; skipping npm globals (re-run chezmoi apply once Vite+ is installed)."
{{ end -}}
