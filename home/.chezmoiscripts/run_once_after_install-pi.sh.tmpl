{{ if lookPath "npm" -}}
#!/usr/bin/env bash
set -euo pipefail

# Installs Pi once into Homebrew's prefix, so it stays on PATH whichever Node
# version fnm activates per project (it still needs Node >= 22.19). After this,
# Pi updates itself.
if command -v pi >/dev/null 2>&1; then
  exit 0
fi
echo "🤖 Installing Pi..."
npm install -g --prefix "$(brew --prefix)" @earendil-works/pi-coding-agent
{{ else -}}
#!/usr/bin/env bash
echo "⚠️  npm not found; skipping Pi (re-run chezmoi apply once Node is ready)."
{{ end -}}
