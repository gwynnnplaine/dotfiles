#!/usr/bin/env bash
set -euo pipefail

# Installs brew.formulae and brew.casks from .chezmoidata/packages.yaml.
# Runs before files are written, and again whenever either list changes.
# --no-upgrade: updating installed packages stays a manual `brew upgrade`.

if ! command -v brew >/dev/null 2>&1; then
  echo "⚠️  Homebrew not found; install it first (see README)." >&2
  exit 1
fi

echo "🍺 Installing Homebrew packages..."
brew bundle install --file=/dev/stdin --no-upgrade <<'BREWFILE'
{{ range .brew.formulae -}}
brew {{ . | quote }}
{{ end -}}
{{ range .brew.casks -}}
cask {{ . | quote }}
{{ end -}}
BREWFILE
