{
    "$schema": "https://raw.githubusercontent.com/JanDeDobbeleer/oh-my-posh/main/themes/schema.json",
    "version": 2,
    "final_space": false,
    "console_title_template": "{{ .Shell }} in {{ .Folder }}",
    "palettes": {
        "template": "{{ if eq (cmd \"bash\" \"-c\" \"defaults read -g AppleInterfaceStyle 2>/dev/null || echo Light\") \"Dark\" }}catppuccin-mocha{{ else }}catppuccin-latte{{ end }}",
        "list": {
            "catppuccin-mocha": {
                "bg0": "#1e1e2e",
                "gray": "#7f849c",
                "red": "#f38ba8",
                "green": "#a6e3a1",
                "yellow": "#f9e2af",
                "blue": "#89b4fa",
                "purple": "#cba6f7",
                "aqua": "#94e2d5",
                "orange": "#fab387",
                "pink": "#f5c2e7",
                "lavender": "#b4befe"
            },
            "catppuccin-latte": {
                "bg0": "#eff1f5",
                "gray": "#8c8fa1",
                "red": "#d20f39",
                "green": "#40a02b",
                "yellow": "#df8e1d",
                "blue": "#1e66f5",
                "purple": "#8839ef",
                "aqua": "#179299",
                "orange": "#fe640b",
                "pink": "#ea76cb",
                "lavender": "#7287fd"
            }
        }
    },
    "palette": {
        "true": "p:green",
        "false": "p:red",
        "time": "p:gray",
        "os-fg": "p:bg0",
        "os-bg": "p:blue",
        "root-fg": "p:bg0",
        "root-bg": "p:orange",
        "path": "p:pink",
        "git": "p:lavender",
        "docker": "p:aqua",
        "go": "p:orange",
        "haskell": "p:orange",
        "julia": "p:orange",
        "lua": "p:orange",
        "node": "p:blue",
        "python": "p:orange",
        "rust": "p:orange"
    },
    "transient_prompt": {
        "foreground": "p:time",
        "template": "{{ now | date \"15:04:05\" }} {{ if gt .Code 0 }}<p:false>\u276f</>{{ else }}<p:true>\u276f</>{{ end }} "
    },
    "blocks": [
        {
            "type": "prompt",
            "alignment": "left",
            "newline": true,
            "segments": [
                {
                    "type": "os",
                    "style": "diamond",
                    "trailing_diamond": "\ue0b0",
                    "foreground": "p:os-fg",
                    "background": "p:os-bg",
                    "foreground_templates": [
                        "{{ if .Root }}p:root-fg{{ end }}"
                    ],
                    "background_templates": [
                        "{{ if .Root }}p:root-bg{{ end }}"
                    ],
                    "template": " {{ .Icon }} ",
                    "properties": {
                        "windows": "\ue70f"
                    }
                },
                {
                    "type": "path",
                    "style": "plain",
                    "foreground": "p:path",
                    "template": " {{ .Path }} ",
                    "properties": {
                        "home_icon": "~",
                        "style": "full"
                    }
                },
                {
                    "type": "git",
                    "style": "plain",
                    "foreground": "p:git",
                    "template": "{{ .HEAD }}{{ if .BranchStatus }} {{ .BranchStatus }}{{ end }}{{ if .Working.Changed }} modified{{ end }}{{ if .Staging.Changed }} staged{{ end }}{{ if gt .StashCount 0 }} stashed{{ end }} ",
                    "properties": {
                        "branch_icon": "\ue725 ",
                        "cherry_pick_icon": "\ue29b ",
                        "commit_icon": "\uf417 ",
                        "fetch_status": true,
                        "fetch_stash_count": true,
                        "merge_icon": "\ue727 ",
                        "no_commits_icon": "\uf0c3 ",
                        "rebase_icon": "\ue728 ",
                        "revert_icon": "\uf0e2 ",
                        "tag_icon": "\uf412 "
                    }
                },
                {
                    "type": "node",
                    "style": "plain",
                    "foreground": "p:node",
                    "template": "\ue718 {{ if .Error }}{{ .Error }}{{ else }}{{ .Full }}{{ end }} "
                },
                {
                    "type": "docker",
                    "style": "plain",
                    "foreground": "p:docker",
                    "template": "\uf308 {{ .Context }} "
                },
                {
                    "type": "go",
                    "style": "plain",
                    "foreground": "p:go",
                    "template": "\ue627 {{ if .Error }}{{ .Error }}{{ else }}{{ .Full }}{{ end }} "
                },
                {
                    "type": "haskell",
                    "style": "plain",
                    "foreground": "p:haskell",
                    "template": "\ue61f {{ if .Error }}{{ .Error }}{{ else }}{{ .Full }}{{ end }} "
                },
                {
                    "type": "julia",
                    "style": "plain",
                    "foreground": "p:julia",
                    "template": "\ue624 {{ if .Error }}{{ .Error }}{{ else }}{{ .Full }}{{ end }} "
                },
                {
                    "type": "lua",
                    "style": "plain",
                    "foreground": "p:lua",
                    "template": "\ue620 {{ if .Error }}{{ .Error }}{{ else }}{{ .Full }}{{ end }} "
                },
                {
                    "type": "python",
                    "style": "plain",
                    "foreground": "p:python",
                    "template": "\ue73c {{ if .Error }}{{ .Error }}{{ else }}{{ .Full }}{{ end }} ",
                    "properties": {
                        "display_default": false,
                        "display_mode": "context"
                    }
                },
                {
                    "type": "rust",
                    "style": "plain",
                    "foreground": "p:rust",
                    "template": "\ue7a8 {{ if .Error }}{{ .Error }}{{ else }}{{ .Full }}{{ end }} "
                },
                {
                    "type": "executiontime",
                    "style": "plain",
                    "foreground": "p:true",
                    "foreground_templates": [
                        "{{ if .Code }}p:false{{ end }}"
                    ],
                    "template": "\udb81\udd1f {{ .FormattedMs }} ",
                    "properties": {
                        "threshold": 500,
                        "style": "austin"
                    }
                }
            ]
        },
        {
            "type": "prompt",
            "alignment": "left",
            "newline": true,
            "segments": [
                {
                    "type": "status",
                    "style": "plain",
                    "foreground": "p:true",
                    "foreground_templates": [
                        "{{ if gt .Code 0 }}p:false{{ end }}"
                    ],
                    "template": "\u276f ",
                    "properties": {
                        "always_enabled": true
                    }
                }
            ]
        }
    ]
}
