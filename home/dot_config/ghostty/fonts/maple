# Maple Mono: closest free match to MonoLisa, ligatures on. 0.60 em wide,
# so 17 here is about 13% wider than Iosevka at 18.
font-family = "Maple Mono"
font-size = 17
# Variable font: the default 400 weight looks soft on a 1x monitor. A real
# heavier weight stays crisp, unlike font-thicken, which smears the edges.
font-variation = wght=500
font-variation-bold = wght=700
font-variation-italic = wght=500
font-variation-bold-italic = wght=700
