# Monaspace Argon (GitHub Next): soft, rounded humanist mono. Texture healing
# (calt) evens out letter spacing; ss01-ss08 turn on its code ligature sets.
font-family = "Monaspace Argon"
font-size = 16
# Static font: pick a real heavier weight for crispness on a 1x monitor.
font-style = SemiBold
font-style-bold = Bold
font-style-italic = SemiBold Italic
font-style-bold-italic = Bold Italic
font-feature = calt
font-feature = liga
font-feature = ss01
font-feature = ss02
font-feature = ss03
font-feature = ss04
font-feature = ss05
font-feature = ss06
font-feature = ss07
font-feature = ss08
