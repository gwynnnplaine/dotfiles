# config.nu — main Nushell configuration (managed by chezmoi)

# ── PATH ──────────────────────────────────────────────────────────────────────
$env.PATH ++= [
    "~/.local/bin"
    "~/.local/share/bob/nvim-bin"
    "/opt/homebrew/bin"
    "/opt/homebrew/sbin"
    "/Applications/cmux.app/Contents/Resources/bin"
    $"($env.HOME)/Library/pnpm/bin" # pnpm global bins (PNPM_HOME/bin)
]
$env.PNPM_HOME = $"($env.HOME)/Library/pnpm"

# ── Node via Vite+ (vp) ───────────────────────────────────────────────────────
# vp's shims pick the Node version per project at exec time (.node-version,
# package.json engines, .nvmrc), so no cd hook is needed. PATH and the `vp`
# wrapper load from vendor/autoload/vite-plus.nu (run_onchange_after_generate-
# nushell-integrations); zsh loads ~/.config/vite-plus/env via ~/.zshenv.

# ── Editor ────────────────────────────────────────────────────────────────────
$env.EDITOR = "nvim"

# ── Aliases ───────────────────────────────────────────────────────────────────
alias ..  = cd ..
alias ... = cd ../..

# git
alias g   = git
alias gs  = git status
alias ga  = git add
alias gp  = git push
alias gl  = git pull
alias gco = git checkout
alias gd  = git diff
alias gb  = git branch
alias lg  = lazygit
alias h   = herdr
alias nv  = nvim
alias c   = clear
alias cc  = claude
alias p   = pi

# listing — bare `ls` stays Nu's builtin (structured output); eza powers these
alias ll  = eza -lh --icons --group-directories-first
alias la  = eza -lah --icons --group-directories-first
alias lt  = eza --tree --icons --level=2

# ── Nu settings ───────────────────────────────────────────────────────────────
$env.config = {
    show_banner: false
    history: {
        max_size: 10_000
        sync_on_enter: true
        file_format: "sqlite"
    }
    completions: {
        case_sensitive: false
        quick: true
        algorithm: "fuzzy"
    }
}

# ── Carapace completions ──────────────────────────────────────────────────────
# env.nu generates carapace.nu into the cache dir; source it if present.
let carapace_cache = $"($nu.cache-dir)/carapace.nu"
if ($carapace_cache | path exists) {
    source $"($nu.cache-dir)/carapace.nu"
}

# ── Oh My Posh prompt, zoxide & fzf ──────────────────────────────────────────
# Oh My Posh reads config from $env.POSH_THEME. The init script lives in
# vendor/autoload/oh-my-posh.nu (generated by `oh-my-posh init nu`).
# Config auto-switches Rose Pine dark/dawn palette based on macOS appearance.
# zoxide & fzf activated via $nu.data-dir/vendor/autoload/{zoxide,fzf}.nu.
# fzf binds Ctrl-T (files), Ctrl-R (history), Alt-C (cd).
$env.POSH_CONFIG = ($env.HOME | path join ".config/oh-my-posh/config.json")
