{{ if and (lookPath "npx") (lookPath "jq") -}}
#!/usr/bin/env bash
set -euo pipefail

skills_dir="$HOME/.agents/skills"

wanted=$(cat <<'SKILLS'
{{ range .skills }}{{ .name }} {{ .source }}
{{ end }}SKILLS
)

failed=0
while read -r name source <&3; do
  [ -n "$name" ] || continue
  echo "🧠 Installing skill: $name"
  npx -y skills@latest add "$source" --global --agent codex --yes || true
  if [ ! -d "$skills_dir/$name" ]; then
    echo "❌ skill '$name' did not install from $source" >&2
    failed=1
  fi
done 3<<<"$wanted"

[ -d "$skills_dir" ] || exit "$failed"

installed=$(npx -y skills@latest ls --global --json 2>/dev/null \
  | jq -r --arg dir "$skills_dir/" '.[] | select(.path | startswith($dir)) | .path | split("/") | last')

for name in $installed; do
  if printf '%s\n' "$wanted" | awk '{print $1}' | grep -qxF -- "$name"; then
    continue
  fi
  echo "🧹 Removing undeclared skill: $name"
  npx -y skills@latest remove "$name" --global --yes
done

exit "$failed"
{{ else -}}
#!/usr/bin/env bash
echo "⚠️  npx or jq not found; skipping agent skills."
{{ end -}}
