{{- /* chezmoi:modify-template */ -}}
{{- /*
  Merges only the keys chosen here into ~/.pi/agent/settings.json; everything
  Pi maintains itself (defaultModel, defaultProvider, enabledModels,
  defaultThinkingLevel, lastChangelogVersion) passes through, so model
  switches never show in `chezmoi status`. Pi writes keys sorted with no
  trailing newline, which is what toPrettyJson produces.
*/ -}}
{{- $s := fromJson (.chezmoi.stdin | default "{}") -}}
{{- $s = setValueAtPath "packages" (list
      "npm:pi-web-access"
      "npm:@ff-labs/pi-fff"
      "npm:@plannotator/pi-extension"
      "npm:@gwynnnplaine/pi-github"
      "npm:@injaneity/pi-computer-use"
      "npm:pi-cached-compaction"
      "npm:@ogulcancelik/pi-herdr"
      "npm:@ogulcancelik/pi-codex-subagents"
      "npm:@ogulcancelik/pi-anthropic-image-cap"
      "npm:@ogulcancelik/pi-session-recall"
      "npm:@ogulcancelik/pi-herdr-worktree-jump"
      "npm:pi-claude-bridge"
      "npm:@amaster.ai/pi-memory") $s -}}
{{- $s = setValueAtPath "theme" "calm-latte/calm-mocha" $s -}}
{{- $s = setValueAtPath "quietStartup" true $s -}}
{{- $s = setValueAtPath "hideThinkingBlock" true $s -}}
{{- $s = setValueAtPath "showHardwareCursor" true $s -}}
{{- $s = setValueAtPath "treeFilterMode" "no-tools" $s -}}
{{- $s = setValueAtPath "collapseChangelog" true $s -}}
{{- $s = setValueAtPath "enableInstallTelemetry" false $s -}}
{{- $s = setValueAtPath "warnings.anthropicExtraUsage" true $s -}}
{{- /* Dreaming defaults to openai/gpt-4.1-mini (not configured); direct anthropic bills as extra usage. */ -}}
{{- $s = setValueAtPath "pi-memory.dreaming.model" (dict "provider" "claude-bridge" "model" "claude-haiku-5-5") $s -}}
{{- toPrettyJson "  " $s | trimSuffix "\n" -}}
