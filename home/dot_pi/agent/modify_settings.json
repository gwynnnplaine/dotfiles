#!/bin/sh
# chezmoi `modify_` script: stdin is the current ~/.pi/agent/settings.json,
# stdout becomes the new one. We merge only the fields we actually choose and
# leave everything Pi maintains itself untouched, so upgrades never dirty
# `chezmoi status`.
#
# Output must match the bytes Pi writes, or every Pi save looks like drift and
# `chezmoi apply` asks to overwrite: keep Pi's key order (no --sort-keys) and
# its missing trailing newline ("$(...)" strips jq's newline).
#
# Deliberately NOT managed here (Pi rewrites these on its own):
#   lastChangelogVersion, enabledModels, defaultModel, defaultProvider,
#   defaultThinkingLevel
set -eu

# First `chezmoi apply` on a fresh machine: no file on stdin yet.
input=$(cat)
[ -n "$input" ] || input='{}'

printf '%s' "$(printf '%s' "$input" | jq '
  .packages = [
    "git:github.com/dmmulroy/pi-mcp",
    "npm:pi-web-access",
    "npm:pi-themes",
    "npm:@ff-labs/pi-fff",
    "npm:@plannotator/pi-extension",
    "npm:@gwynnnplaine/pi-github",
    "npm:@tmustier/pi-session-hud",
    "npm:@injaneity/pi-computer-use",
    "git:github.com/joelhooks/pi-bellwether"
  ]
| .theme = "gruvbox-warm-light/gruvbox-warm-dark"
| .quietStartup = true
| .hideThinkingBlock = true
| .showHardwareCursor = true
| .treeFilterMode = "no-tools"
| .collapseChangelog = true
| .enableInstallTelemetry = false
| .warnings.anthropicExtraUsage = false
')"
